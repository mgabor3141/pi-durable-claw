# Copy to .env (next to compose.yaml). Every claw setting is here; compose passes the file to the harness whole, and
# reads CLAW_PORT from it too. A line left empty is the same as no line.

# --- The app ---------------------------------------------------------------------------------------------------------
# The port the app listens on, on 127.0.0.1.
CLAW_PORT=3775
# The name T3 shows for this environment; also the device name on your tailnet.
#CLAW_LABEL=claw
# The address pairing links and MCP sign-in callbacks use. Unset: the tailnet address with remote access on, else
# http://127.0.0.1:CLAW_PORT. Set it when you reach the server another way (your own reverse proxy).
#CLAW_PUBLIC_URL=https://claw.example.com
# The time zone of "Local time when this conversation started" in the agent's prompt.
#TZ=Europe/Budapest
# What one codemode script may allocate, in MiB (default 256).
#CLAW_CODEMODE_MEMORY_MB=256
# The harness version to run: a branch, a tag or a commit of the repository (README "Update"). Unset: the newest at
# the first start, then whatever `claw update` installed.
#CLAW_VERSION=main

# --- Remote access (`claw remote`, README "Remote access") -------------------------------------------------------------
# Who may connect besides the account that logs the device in: logins or tags.
#CLAW_TAILNET_ALLOW=partner@example.com,tag:laptops
# The device name, when not CLAW_LABEL's.
#CLAW_TAILNET_HOSTNAME=claw
# Log the device in without the link (https://login.tailscale.com/admin/settings/keys).
#TS_AUTHKEY=tskey-auth-...

# --- Services you run (each feature is off without its URL, and the log says so) ---------------------------------------
# web_search: a SearXNG with its JSON API on.
#SEARXNG_URL=http://searxng:8080
# web_fetch: a page reader answering POST /read (README "Web tools").
#READER_URL=http://reader:8000
# The agent's browser and T3's Browser panel: a Browserless Chromium, and its token if it needs one.
#BROWSERLESS_URL=ws://browserless:3000/chromium
#BROWSERLESS_TOKEN=
# Hosts the browser may open that are otherwise private, comma-separated (e.g. the workspace's own dev servers).
#BROWSER_LOCAL_HOSTS=workspace
# Long-term memory: Hindsight (README "Memory"), its API key if it needs one, and the memory bank (default claw).
#HINDSIGHT_URL=http://hindsight:8888
#HINDSIGHT_API_KEY=
#HINDSIGHT_BANK=claw
