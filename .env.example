# Copy to .env (next to compose.yaml); docker compose reads it for every command.
# The port the app listens on, on 127.0.0.1.
CLAW_PORT=3775
# The address pairing links use; set it when you reach the server another way. With remote access on (`claw remote`)
# the links use the tailnet address on their own.
#CLAW_PUBLIC_URL=https://claw.example.ts.net
# The name T3 shows for this environment; also the device name on your tailnet.
#CLAW_LABEL=claw
# Remote access (`claw remote`): who may connect besides the account that logs the device in (logins or tags), a
# device name other than CLAW_LABEL's, and an auth key to log in without the link (https://login.tailscale.com/admin/settings/keys).
#CLAW_TAILNET_ALLOW=partner@example.com,tag:laptops
#CLAW_TAILNET_HOSTNAME=claw
#TS_AUTHKEY=tskey-auth-...
